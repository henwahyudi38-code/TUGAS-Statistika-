#include <iostream>
#include <cmath>
using namespace std;

// Fungsi faktorial
double faktorial(int n) {
    double hasil = 1;

    for (int i = 1; i <= n; i++) {
        hasil *= i;
    }

    return hasil;
}

// Fungsi kombinasi
double kombinasi(int n, int r) {
    return faktorial(n) / (faktorial(r) * faktorial(n - r));
}

int main() {
    // =========================
    // NOMOR 9 - BINOMIAL
    // =========================

    int n = 5;
    double p = 0.60;
    double q = 1 - p;

    double P3 = kombinasi(n, 3) * pow(p, 3) * pow(q, 2);
    double P4 = kombinasi(n, 4) * pow(p, 4) * pow(q, 1);
    double P5 = kombinasi(n, 5) * pow(p, 5) * pow(q, 0);

    double hasil9 = P3 + P4 + P5;

    cout << "======================================" << endl;
    cout << "       SOAL NOMOR 9 - BINOMIAL" << endl;
    cout << "======================================" << endl;

    cout << "P(X=3) = " << P3 << endl;
    cout << "P(X=4) = " << P4 << endl;
    cout << "P(X=5) = " << P5 << endl;

    cout << "P(X>=3) = " << hasil9 << endl;
    cout << "Persentase = " << hasil9 * 100 << "%" << endl;


    // =========================
    // NOMOR 10 - POISSON
    // =========================

    double lambda = 1;
    int x = 2;

    double hasil10 =
        (exp(-lambda) * pow(lambda, x)) / faktorial(x);

    cout << endl;
    cout << "======================================" << endl;
    cout << "       SOAL NOMOR 10 - POISSON" << endl;
    cout << "======================================" << endl;

    cout << "Lambda = " << lambda << endl;
    cout << "X = " << x << endl;

    cout << "P(X=2) = " << hasil10 << endl;
    cout << "Persentase = " << hasil10 * 100 << "%" << endl;

    return 0;
}